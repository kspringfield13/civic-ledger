# ============================================================
# civic-ledger — environment template
# Copy to .env in the EXECUTION ENVIRONMENT ONLY.
# NEVER commit a real .env. NEVER paste real keys into chat.
# For production, use encrypted secret management (e.g. cloud
# secret manager, SOPS, Vault) instead of dotenv files.
# Secret scanning: run `make secrets-scan` (gitleaks) before push.
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- Database -----------------------------------------------
# Default: SQLite prototype mode (no Postgres required).
# Switch to Postgres by setting DATABASE_URL, e.g.:
#   postgresql+psycopg://USER:PASS@HOST:5432/DB
DATABASE_URL=sqlite:///./local.db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Frontend -----------------------------------------------
FRONTEND_API_BASE_URL=http://localhost:8000

# --- API keys (ALL OPTIONAL) --------------------------------
# Leave blank until the specific integration is actually built.
# Each key belongs only in the environment that runs that
# integration — do not distribute keys across machines.
ANTHROPIC_API_KEY=          # LLM-assisted triage/summarization (future)
OPENAI_API_KEY=             # alternative LLM provider (future)
PERPLEXITY_API_KEY=         # research assistance (future)
SERP_API_KEY=               # public web search (future)
COURT_LISTENER_API_KEY=     # public court records via CourtListener (future)
GOVINFO_API_KEY=            # govinfo.gov public documents (future)
SEC_API_KEY=                # SEC EDGAR tooling (future; EDGAR itself is keyless)
